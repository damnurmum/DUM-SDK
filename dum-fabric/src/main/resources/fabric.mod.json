{
	"schemaVersion": 1,
	"id": "dum-sdk",
	"version": "${version}",
	"name": "DUM-SDK",
	"description": "Client side of DUM-SDK: connects to the DUM server and runs the client modules it provides.",
	"authors": ["DUM"],
	"license": "MIT",
	"environment": "client",
	"accessWidener": "dum-sdk.classtweaker",
	"mixins": ["dum-sdk.mixins.json"],
	"entrypoints": {
		"client": ["ru.dum.sdk.fabric.DumSdkClient"]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	}
}
